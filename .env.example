#Local / Docker Compose
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/platform
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=platform
GEMINI_API_KEY=your-gemini-api-key-here
CHROMA_HOST=localhost
AGENT_WORKER_URL=http://agent-worker:8080

#Auth Service
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

#Auth Service — Cloud SQL (production only, local için boş bırak)
CLOUD_SQL_INSTANCE=
DB_USER=
DB_PASS=
DB_NAME=
DB_IP_TYPE=PUBLIC

# Quota Service
QUOTA_LIMIT=10
QUOTA_TTL_SECONDS=86400
REDIS_URL=redis://redis:6379/0

#GitHub Actions Secrets
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GAR_LOCATION=us-central1
GAR_REPO=seller-support
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github-pool/providers/github-provider
GCP_SERVICE_ACCOUNT=github-actions@your-gcp-project-id.iam.gserviceaccount.com
