# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Local infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=platform
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/platform
BROKER_DATABASE_URL=postgresql+psycopg2://postgres:password@postgres:5432/platform
REDIS_URL=redis://redis:6379/0

# Local service URLs
AUTH_SERVICE_URL=http://auth-service:8080
TASK_SERVICE_URL=http://task-service:8080
QUOTA_SERVICE_URL=http://quota-service:8080
AGENT_WORKER_URL=http://agent-worker:8080
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth service
JWT_SECRET_KEY=your-local-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REGISTRATION_ENABLED=true

# Quota service
QUOTA_LIMIT=10
QUOTA_TTL_SECONDS=86400

# Broker worker
TASK_QUEUE_NAME=task_queue
MAX_RETRY_COUNT=3
RETRY_BASE_DELAY=2.0

# Google Cloud
GOOGLE_CLOUD_PROJECT=synapse-btk-hackathon-2026
GOOGLE_CLOUD_LOCATION=us-central1

# Rival agent models
RIVAL_DISCOVERY_MODEL=gemini-2.5-flash-lite
RIVAL_RESEARCH_MODEL=gemini-2.5-flash-lite
RIVAL_SENTIMENT_MODEL=gemini-2.5-flash
RIVAL_TRENDS_MODEL=gemini-2.5-flash
RIVAL_MARKET_GAP_MODEL=gemini-2.5-flash
RIVAL_PRICING_MODEL=gemini-2.5-flash

# SEO agent
SEO_OPTIMIZER_MODEL=gemini-2.5-flash

# Image generation
GEMINI_IMAGE_MODEL=gemini-2.5-flash-preview-image-generation
GCS_BUCKET=synapse-btk-hackathon-images

# RAG
CHROMA_COLLECTION_NAME=seo_rules
CHROMA_TOP_K=6

# Cloud Run
GCP_PROJECT_ID=synapse-btk-hackathon-2026
GCP_REGION=us-central1
GAR_LOCATION=us-central1
GAR_REPO=synapse-btk-hackathon
CLOUD_SQL_INSTANCE=synapse-btk-hackathon-2026:us-central1:synapse-postgres
DB_USER=postgres
DB_PASS=
DB_NAME=platform
DB_IP_TYPE=PUBLIC

# GitHub Actions
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github-pool/providers/github-provider
GCP_SERVICE_ACCOUNT=github-deploy-sa@synapse-btk-hackathon-2026.iam.gserviceaccount.com