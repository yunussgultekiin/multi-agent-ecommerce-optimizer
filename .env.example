# ── Shared Infrastructure ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=platform
REDIS_URL=redis://redis:6379/0

# ── Auth Service ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/platform
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth Service — Cloud SQL (Leave blank for production only, local)
CLOUD_SQL_INSTANCE=
DB_USER=
DB_PASS=
DB_NAME=
DB_IP_TYPE=PUBLIC

# ── Quota Service ─────────────────────────────────────────────────
QUOTA_LIMIT=10
QUOTA_TTL_SECONDS=86400

# ── Task Service ──────────────────────────────────────────────────
APP_ENV=development

# ── Broker Worker ─────────────────────────────────────────────────
BROKER_DATABASE_URL=postgresql+psycopg2://postgres:password@postgres:5432/platform
AGENT_WORKER_URL=http://agent-worker:8080
TASK_SERVICE_URL=http://task-service:8080
TASK_QUEUE_NAME=task_queue
MAX_RETRY_COUNT=3
RETRY_BASE_DELAY=2.0

# ── Agent Worker ──────────────────────────────────────────────────
# Authentication via Application Default Credentials (no API key needed)
# Local setup: gcloud auth application-default login --no-launch-browser
GOOGLE_CLOUD_PROJECT=ai-driven-seller-support
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_VISION_MODEL=
GEMINI_FLASH_MODEL=gemini-3-flash
GEMINI_PRO_MODEL=gemini-3-pro
CHROMA_HOST=localhost

# ── Shared / All Services ────────────────────────────────────────
LOG_LEVEL=INFO

# ── GCP / Cloud Run (production only) ────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GAR_LOCATION=us-central1
GAR_REPO=seller-support
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github-pool/providers/github-provider
GCP_SERVICE_ACCOUNT=github-actions@your-gcp-project-id.iam.gserviceaccount.com
